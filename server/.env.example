# Database (Supabase Postgres direct connection for now)
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT.supabase.co:5432/postgres

# JWT
JWT_SECRET=generate-a-secure-random-string-here

# Site
SITE_URL=https://pennysite.app
CORS_ORIGINS=http://localhost:3000,https://pennysite.app
PORT=3001

# AI (at least one required)
OPENAI_API_KEY=sk-your-api-key
ANTHROPIC_API_KEY=sk-ant-your-api-key

# Stripe
STRIPE_SECRET_KEY=sk_test_your-secret-key
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-secret
STRIPE_PRICE_STARTER=price_xxx
STRIPE_PRICE_BASIC=price_xxx
STRIPE_PRICE_PRO=price_xxx
STRIPE_PRICE_MAX=price_xxx

# Credit pricing (optional, defaults shown)
# BASE_CREDITS_PER_GENERATION=5
# CREDITS_PER_INPUT_TOKEN=0.001
# CREDITS_PER_OUTPUT_TOKEN=0.005
# MAX_RESERVED_CREDITS=150
# ENHANCE_RESERVED_CREDITS=30

# Cloudflare Pages (for publishing user sites)
CLOUDFLARE_ACCOUNT_ID=your-account-id
CLOUDFLARE_API_TOKEN=your-api-token

# Resend (email)
RESEND_API_KEY=re_your-api-key
RESEND_FROM_EMAIL=Pennysite <noreply@pennysite.app>

# PostHog
POSTHOG_KEY=phc_your-key
POSTHOG_HOST=https://us.i.posthog.com

# Sentry
SENTRY_DSN=https://your-key@o0.ingest.us.sentry.io/0

# Cron secret (used for unsubscribe token generation)
CRON_SECRET=your-random-secret
