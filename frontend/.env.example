# API URL (leave empty in dev — Vite proxy handles it)
# In production, set to your backend URL
VITE_API_URL=

# Site URL
VITE_SITE_URL=https://pennysite.app

# PostHog
VITE_POSTHOG_KEY=phc_your-key
VITE_POSTHOG_HOST=https://us.i.posthog.com

# Sentry
VITE_SENTRY_DSN=https://your-key@o0.ingest.us.sentry.io/0
